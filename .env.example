# Copy to .env for local development. The Makefile exports these to every target.

# --- HTTP server ---
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Networks of reverse proxies and load balancers in front of the API, in CIDR notation, separated by commas, such
# as 10.0.0.0/8. Requests from them are attributed to the client address in X-Forwarded-For, for the per-address
# rate limit. Empty trusts nobody: right when clients connect directly.
HTTP_TRUSTED_PROXIES=

# --- Metrics (Prometheus) ---
# Listener of the API for GET /metrics, apart from HTTP_ADDR so that it can stay on an internal network
METRICS_ADDR=:9090
# Listener of the worker for GET /metrics, /healthz, and /readyz. Workers on one host need an address each;
# a port of 0 picks a free one, which the worker logs.
WORKER_METRICS_ADDR=:9091

# --- PostgreSQL (source of truth, required) ---
DATABASE_URL=postgres://postgres:root@localhost:5432/cinema?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
# How long a booking transaction waits for a row lock before answering 409 SEAT_BUSY. Below HTTP_WRITE_TIMEOUT.
DB_LOCK_TIMEOUT=3s

# --- Redis (accelerator, fail-open) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms
# Dial attempts per new connection; REDIS_DIAL_TIMEOUT applies to each attempt
REDIS_DIAL_ATTEMPTS=1
# -1 disables retries; keep it low so a Redis outage does not slow down requests
REDIS_MAX_RETRIES=1
# Every key the application writes starts with this prefix and a colon, so deployments can share one Redis
REDIS_KEY_PREFIX=cinema

# --- Logging ---
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | text
LOG_FORMAT=json

# --- Cinema ---
# IANA time zone: schedule days start at local midnight, response times carry this offset
CINEMA_TIMEZONE=UTC
# ISO 4217 currency code of all prices
CINEMA_CURRENCY=USD

# --- Auth ---
# HS256 signing key for access tokens, at least 32 bytes. Required by the API only.
# This value is a local-development placeholder; generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-placeholder-secret-replace-me-0123456789
# Lifetime of an access token (at most 24h). There are no refresh tokens: clients log in again.
JWT_TTL=1h
# bcrypt work factor, 10-14. Each step doubles the time of a login (12 is about 170 ms on a laptop).
BCRYPT_COST=12
# Admin account that `make seed` creates, or promotes and resets. Without a password it is skipped.
ADMIN_EMAIL=admin@cinema.local
ADMIN_PASSWORD=change-me-admin

# --- Booking ---
# How long a booking holds its seats while waiting for payment (10s to 24h)
BOOKING_HOLD_TTL=15m
# Most seats one booking may hold (1 to 50)
BOOKING_MAX_SEATS=10
# How long the Redis hold gate reserves the seats of a booking request whose transaction has not committed yet
# (longer than DB_LOCK_TIMEOUT, at most 1m). A crashed request blocks its seats in the gate for at most this long.
HOLD_CLAIM_TTL=15s

# --- Expiry worker (cmd/worker) ---
# Average pause between two sweeps for bookings whose hold has run out (1s to 10m, varied by up to 20%)
EXPIRER_INTERVAL=5s
# Most bookings one transaction expires (1 to 5000); a sweep runs batches until one comes back short
EXPIRER_BATCH_SIZE=500

# --- Payments ---
# Longest wait for a payment provider's answer (at least 1s, shorter than HTTP_WRITE_TIMEOUT). Without an
# answer the payment stays in flight, the API answers 202, and the worker settles it later.
PAYMENT_TIMEOUT=10s
# How long a payment may stay in flight before the worker asks its provider about it (longer than
# PAYMENT_TIMEOUT, at most 1h)
PAYMENT_GRACE=2m
# Local test provider: test tokens such as tok_success pay for bookings without moving money.
# For development only; it is off unless enabled, and must stay off in production.
PAYMENT_LOCAL_ENABLED=false

# --- Payment reconciler (cmd/worker) ---
# Average pause between two passes over payments left in flight (1s to 10m, varied by up to 20%)
RECONCILER_INTERVAL=30s

# --- Caches (Redis) ---
# How long a seat map is served from the cache (0 turns it off, at most 1m). Every committed seat change also
# deletes the seat map of its showtime.
SEATMAP_CACHE_TTL=5s
# How long the schedule of a day is served from the cache (0 turns it off, at most 1m). The free seat counts in
# the schedule may be this old.
SCHEDULE_CACHE_TTL=10s

# --- Rate limits (Redis; 0 turns a limit off, at most 10000; every request passes while Redis is down) ---
# Booking attempts per user and minute
BOOKING_RATE_LIMIT_PER_MIN=20
# Login and registration attempts per client IP address (per /64 network for IPv6) and minute
AUTH_IP_RATE_LIMIT_PER_MIN=30
# Login attempts per account email and minute, from any address
LOGIN_EMAIL_RATE_LIMIT_PER_MIN=10
